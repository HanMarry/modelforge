{
  "description": "Shared masking vectors for ui/desktop/src/utils/secretMask.ts and crates/goose/src/logging/secret_mask.rs (requirement 1.10). Lengths are counted in Unicode code points.",
  "mask": [
    { "input": "", "masked": "********" },
    { "input": "a", "masked": "********" },
    { "input": "12345678", "masked": "********" },
    { "input": "123456789", "masked": "********6789" },
    { "input": "ABCDEFGHIJKL", "masked": "********IJKL" },
    { "input": "sk-abcdefghij", "masked": "********ghij" },
    { "input": "密钥一二三四五六七", "masked": "********四五六七" },
    { "input": "密钥一二三四五六", "masked": "********" },
    { "input": "🔑🔑🔑🔑🔑🔑🔑🔑🔑", "masked": "********🔑🔑🔑🔑" },
    { "input": "ab🔑cd🔑ef🔑", "masked": "********🔑ef🔑" }
  ],
  "redact": [
    {
      "text": "Authorization: Bearer sk-live-1234567890abcd",
      "secrets": ["sk-live-1234567890abcd"],
      "expected": "Authorization: Bearer ********abcd"
    },
    {
      "text": "x=abcdefghijklmnop y=ghijklmnop",
      "secrets": ["ghijklmnop", "abcdefghijklmnop"],
      "expected": "x=********mnop y=********mnop"
    },
    {
      "text": "abcd abcd",
      "secrets": ["abcd", ""],
      "expected": "abcd abcd"
    },
    {
      "text": "token=令牌一二三四五六七八;",
      "secrets": ["令牌一二三四五六七八"],
      "expected": "token=********五六七八;"
    },
    {
      "text": "pw hunter22!",
      "secrets": ["hunter22"],
      "expected": "pw ********!"
    },
    {
      "text": "abcdefg",
      "secrets": ["cdefg", "abcde"],
      "expected": "********fg"
    }
  ]
}
