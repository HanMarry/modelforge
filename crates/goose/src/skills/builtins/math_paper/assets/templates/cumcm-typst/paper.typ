  ```python
  import pulp

  problem = pulp.LpProblem("production", pulp.LpMaximize)
  x = pulp.LpVariable.dicts("x", products, lowBound=0)
  problem += pulp.lpSum(c[j] * x[j] for j in products)
  for i in resources:
      problem += pulp.lpSum(a[i][j] * x[j] for j in products) <= b[i]
  problem.solve(pulp.PULP_CBC_CMD(msg=False))
  ```
